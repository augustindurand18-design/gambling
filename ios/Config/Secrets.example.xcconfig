// Copier en Secrets.xcconfig (gitignore) et renseigner.
//
// Attention : en xcconfig, // ouvre un commentaire, y compris a droite d'un
// signe egal. Une URL ecrite telle quelle perd donc tout ce qui suit
// « http: », sans le moindre avertissement.
//
// La parade est de composer les deux barres a partir d'une variable qui n'en
// contient qu'une. Definir SLASHES = // ne marche pas : la valeur est vide,
// et l'URL obtenue ressemble a « http:127.0.0.1 » — acceptee par le
// compilateur, refusee par le client Supabase au lancement.

SLASH = /

// Supabase local par defaut (supabase start)
SUPABASE_URL = http:$(SLASH)$(SLASH)127.0.0.1:54321
SUPABASE_ANON_KEY =

// Stripe — cle publiable de TEST uniquement (pk_test_...)
STRIPE_PUBLISHABLE_KEY =

// Observabilite (optionnel en dev)
SENTRY_DSN =
TELEMETRYDECK_APP_ID =

// Equipe de signature Apple
DEVELOPMENT_TEAM =
