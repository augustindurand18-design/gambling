// Copier en Secrets.xcconfig (gitignore) et renseigner.
//
// Attention : les valeurs contenant // doivent etre echappees en xcconfig.
// Astuce usuelle : definir SLASHES = // puis ecrire https:$(SLASHES)exemple.com

SLASHES = //

// Supabase local par defaut (supabase start)
SUPABASE_URL = http:$(SLASHES)127.0.0.1:54321
SUPABASE_ANON_KEY =

// Stripe — cle publiable de TEST uniquement (pk_test_...)
STRIPE_PUBLISHABLE_KEY =

// Observabilite (optionnel en dev)
SENTRY_DSN =
TELEMETRYDECK_APP_ID =

// Equipe de signature Apple
DEVELOPMENT_TEAM =
